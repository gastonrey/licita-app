# ============================================================================
# licita-agent configuration
# Secrets have NO defaults anywhere. Boot fails fast (listing every missing or
# invalid variable) when the config is incomplete — see src/config.validate.ts.
# ============================================================================

# ----------------------------------------------------------------------------
# Local development (docker-compose.yml / npm run dev)
# ----------------------------------------------------------------------------

# Database: either a full URL or the PG* parts (docker-compose sets PG*)
DATABASE_URL=
# Optional: separate low-privilege role for app traffic (falls back to
# DATABASE_URL). Migrations always run with the admin DATABASE_URL.
APP_DATABASE_URL=
PGHOST=db
PGPORT=5432
PGUSER=licita
PGPASSWORD=licita
PGDATABASE=licita

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
# Trust X-Forwarded-For etc. from a reverse proxy: 'true', 'false', or a hop
# count. Keep 'false' when the app is directly exposed.
TRUST_PROXY=false
# Max distinct client keys tracked by the in-memory rate limiter.
RATE_LIMIT_MAX_KEYS=10000

# Payments: dev = built-in HMAC faucet; x402 = real facilitator seam
PAYMENTS_MODE=dev
# REQUIRED in dev mode (boot fails without it): HMAC secret signing dev
# payment tokens. Any random string; this one is a placeholder — set your own.
PAY_HMAC_SECRET=
# x402 config (not needed in dev mode). facilitatorUrl/network have safe
# defaults; X402_PAY_TO has NO default (production boot fails without it).
# facilitator: Coinbase CDP facilitator, works for both Sepolia and mainnet.
X402_FACILITATOR_URL=https://www.x402.org/facilitator
# CAIP-2 network: 'eip155:84532' = Base Sepolia (testnet, default),
# 'eip155:8453' = Base mainnet. Other eip155:<chainId> = explicit override.
X402_NETWORK=eip155:84532
# Ethereum address receiving USDC. The project wallet (public, not a secret):
# 0x3bF0F00f4c8e46CA4bFEa5D77cCDdCFC95c5ac5E
X402_PAY_TO=

# REQUIRED always (boot fails without it): header x-operator-key for
# GET /v1/stats. Any random string; set your own.
OPERATOR_KEY=

# Ingestion
INGEST_MONTHS=24
INGEST_ON_BOOT=false
INGEST_CRON_HOUR=4

# ----------------------------------------------------------------------------
# Production (docker-compose.prod.yml) — ALL of these are enforced at boot
# ----------------------------------------------------------------------------
#
# NODE_ENV=production
# PAYMENTS_MODE=x402                  # dev mode refuses to boot in production
# PAY_HMAC_SECRET=<not used by x402; must not be "change-me-in-prod">
# OPERATOR_KEY=<random>               # must not be "change-me"
# X402_PAY_TO=0x<40 hex chars>        # Ethereum address receiving USDC
# X402_FACILITATOR_URL=https://www.x402.org/facilitator  # default; https only
# X402_NETWORK=eip155:8453            # Base mainnet (default: eip155:84532 Base Sepolia)
# DATABASE_URL=postgres://<admin>@db:5432/licita      # used by migrations
# APP_DATABASE_URL=postgres://licita_app:<pw>@db:5432/licita  # app traffic (no DDL)
# TRUST_PROXY=true                    # when a reverse proxy terminates TLS
