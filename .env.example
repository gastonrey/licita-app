# ============================================================================
# licita-agent configuration
# Secrets have NO defaults anywhere. Boot fails fast (listing every missing or
# invalid variable) when the config is incomplete — see src/config.validate.ts.
# ============================================================================

# ----------------------------------------------------------------------------
# Local development (docker-compose.yml / npm run dev)
# ----------------------------------------------------------------------------

# Database: either a full URL or the PG* parts (docker-compose sets PG*)
DATABASE_URL=
# Optional: separate low-privilege role for app traffic (falls back to
# DATABASE_URL). Migrations always run with the admin DATABASE_URL.
APP_DATABASE_URL=
PGHOST=db
PGPORT=5432
PGUSER=licita
PGPASSWORD=licita
PGDATABASE=licita

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
# Trust X-Forwarded-For etc. from a reverse proxy: 'true', 'false', or a hop
# count. Keep 'false' when the app is directly exposed.
TRUST_PROXY=false
# Max distinct client keys tracked by the in-memory rate limiter.
RATE_LIMIT_MAX_KEYS=10000

# Payments: dev = built-in HMAC faucet; x402 = real facilitator seam
PAYMENTS_MODE=dev
# REQUIRED in dev mode (boot fails without it): HMAC secret signing dev
# payment tokens. Any random string; this one is a placeholder — set your own.
PAY_HMAC_SECRET=
# x402 config (not needed in dev mode). facilitatorUrl/network have safe
# defaults; X402_PAY_TO has NO default (production boot fails without it).
# facilitator: Coinbase CDP facilitator, works for both Sepolia and mainnet.
# For Base MAINNET, Coinbase's official facilitator only supports Sepolia —
# use https://x402.primer.systems (mainnet) when on eip155:8453.
X402_FACILITATOR_URL=https://www.x402.org/facilitator
# CAIP-2 network: 'eip155:84532' = Base Sepolia (testnet, default),
# 'eip155:8453' = Base mainnet. Other eip155:<chainId> = explicit override.
X402_NETWORK=eip155:84532
# Ethereum address receiving USDC. The project wallet (public, not a secret):
# 0x99D4Bfb2296E4b7e9f85B328Df3569f060dca9C7
X402_PAY_TO=
# Retries for transient facilitator/RPC failures (0 disables; default 3).
# Public facilitators can be flaky on mainnet (observed: ~90% verify failures
# with CALL_EXCEPTION/simulation_reverted on Primer). verify retries are safe
# (nonce not consumed); settle retries need X402_RPC_URL (on-chain guard).
X402_FACILITATOR_RETRIES=3
# Stable RPC for the settle-retry on-chain guard (eth_getLogs Transfer lookup).
# MUST be a reliable public RPC for X402_NETWORK, NOT the flaky facilitator RPC.
# Examples: https://mainnet.base.org (Base mainnet), https://sepolia.base.org
# (Base Sepolia). When set, a flaky settle is retried only if the previous
# attempt did NOT land on-chain (prevents double charge). When unset, settle is
# attempted exactly once and fails closed on any error.
X402_RPC_URL=

# REQUIRED always (boot fails without it): header x-operator-key for
# GET /v1/stats. Any random string; set your own.
OPERATOR_KEY=

# Ingestion
INGEST_MONTHS=24
INGEST_ON_BOOT=false
INGEST_CRON_HOUR=4

# PLACSP ingestion (Spanish PLACSP sindicación ATOM/CODICE feeds). Disabled by
# default; the TED path is unaffected. PLACSP_ENABLED=true allows running it
# via `npm run ingest -- --once --source placsp|all`; PLACSP_SCHEDULE=true
# also includes it in the daily scheduler run. PLACSP_MAX_PAGES caps the
# RFC 5005 pages fetched per feed; PLACSP_DELAY_MS is the minimum delay
# between feed requests (be polite: keep >= 500).
PLACSP_ENABLED=false
PLACSP_MAX_PAGES=5
PLACSP_DELAY_MS=500
PLACSP_SCHEDULE=false

# ----------------------------------------------------------------------------
# Lead notifications (operator-only, best-effort)
# When a POST /v1/demo/request succeeds, fire-and-forget an email to the
# operator inbox. The lead is also stored in demo_requests and visible on the
# operator dashboard; this is the "ping the operator" channel.
# Leave RESEND_API_KEY empty to disable notifications entirely.
# ----------------------------------------------------------------------------
# Where the lead notification is delivered. Default: matches CONTACT_EMAIL in
# src/web/pages.ts. Override per environment.
LEAD_NOTIFY_EMAIL=eutendersai@gmail.com
# Resend HTTP API key. Sign up at https://resend.com and create an API key.
# Format: re_<40+ chars>. Leave empty in dev/test.
RESEND_API_KEY=
# Verified Resend "From" header. Use a domain you control in production.
RESEND_FROM=Licita Operator <operator@licita.app>

# ----------------------------------------------------------------------------
# Production (docker-compose.prod.yml) — ALL of these are enforced at boot
# ----------------------------------------------------------------------------
#
# NODE_ENV=production
# PAYMENTS_MODE=x402                  # dev mode refuses to boot in production
# PAY_HMAC_SECRET=<not used by x402; must not be "change-me-in-prod">
# OPERATOR_KEY=<random>               # must not be "change-me"
# X402_PAY_TO=0x<40 hex chars>        # Ethereum address receiving USDC
# X402_FACILITATOR_URL=https://x402.primer.systems  # mainnet-capable facilitator
# X402_NETWORK=eip155:8453            # Base mainnet (default: eip155:84532 Base Sepolia)
# X402_FACILITATOR_RETRIES=3          # retries for transient facilitator/RPC failures
# X402_RPC_URL=https://mainnet.base.org  # stable RPC for the settle-retry on-chain guard
# DATABASE_URL=postgres://<admin>@db:5432/licita      # used by migrations
# APP_DATABASE_URL=postgres://licita_app:<pw>@db:5432/licita  # app traffic (no DDL)
# TRUST_PROXY=true                    # when a reverse proxy terminates TLS

# --- smoke-agent (scripts/smoke-agent.ts) ------------------------------------
# SMOKE_PAY_MODE=dev  mints HMAC tokens via POST /v1/dev-faucet (local dev only).
# SMOKE_PAY_MODE=x402 runs a REAL x402 v2 flow: it signs EIP-3009
# transferWithAuthorization of USDC and settles testnet payments through the
# server's facilitator. Requires a Base Sepolia wallet funded with ETH (gas) +
# USDC. SMOKE_WALLET_PRIVATE_KEY must be a TESTNET THROWAWAY key ONLY — never a
# production/mainnet key, and never commit a real value here.
# SMOKE_PAY_MODE=dev
# SMOKE_WALLET_PRIVATE_KEY=0x<64 hex testnet throwaway>
# SMOKE_RPC_URL=https://sepolia.base.org   # optional pre-flight balance check
