# Database: either a full URL or the PG* parts (docker-compose sets PG*)
DATABASE_URL=
PGHOST=db
PGPORT=5432
PGUSER=licita
PGPASSWORD=licita
PGDATABASE=licita

# Server
PORT=3000
LOG_LEVEL=info

# Payments: dev = built-in test faucet; x402 = real facilitator (not configured = MVP default dev)
PAYMENTS_MODE=dev
PAY_HMAC_SECRET=change-me-in-prod
X402_FACILITATOR_URL=
X402_PAY_TO=
X402_NETWORK=

# Operator stats endpoint key
OPERATOR_KEY=change-me

# Ingestion
INGEST_MONTHS=24
INGEST_ON_BOOT=false
INGEST_CRON_HOUR=4
